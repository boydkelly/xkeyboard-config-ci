# ~/.XCompose
include "%L"

# ===============================================================
# ACUTE ACCENT (U0301) - AltGr + /
# ===============================================================

# Standard Vowels
<U0301> <a> : "á"
<U0301> <A> : "Á"
<U0301> <e> : "é"
<U0301> <E> : "É"
<U0301> <i> : "í"
<U0301> <I> : "Í"
<U0301> <o> : "ó"
<U0301> <O> : "Ó"
<U0301> <u> : "ú"
<U0301> <U> : "Ú"

# Nasals
<U0301> <n> : "ń"
<U0301> <N> : "Ń"

# Extended Latin
<U0301> <U025B> : "ɛ́"  # epsilon
<U0301> <U0190> : "Ɛ́"  # EPSILON
<U0301> <U0254> : "ɔ́"  # open o
<U0301> <U0186> : "Ɔ́"  # OPEN O
<U0301> <U0269> : "ɩ́"  # iota
<U0301> <U0196> : "Ɩ́"  # IOTA
<U0301> <U028B> : "ʋ́"  # upsilon
<U0301> <U01B2> : "Ʋ́"  # UPSILON

# ===============================================================
# GRAVE ACCENT (U0300) - AltGr + .
# ===============================================================

# Standard Vowels
<U0300> <a> : "à"
<U0300> <A> : "À"
<U0300> <e> : "è"
<U0300> <E> : "È"
<U0300> <i> : "ì"
<U0300> <I> : "Ì"
<U0300> <o> : "ò"
<U0300> <O> : "Ò"
<U0300> <u> : "ù"
<U0300> <U> : "Ù"

# Nasals
<U0300> <n> : "ǹ"
<U0300> <N> : "Ǹ"

# Extended Latin
<U0300> <U025B> : "ɛ̀"  # epsilon
<U0300> <U0190> : "Ɛ̀"  # EPSILON
<U0300> <U0254> : "ɔ̀"  # open o
<U0300> <U0186> : "Ɔ̀"  # OPEN O
<U0300> <U0269> : "ɩ̀"  # iota
<U0300> <U0196> : "Ɩ̀"  # IOTA
<U0300> <U028B> : "ʋ̀"  # upsilon
<U0300> <U01B2> : "Ʋ̀"  # UPSILON
